<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#08090D">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discord RPC"
        android:textColor="#EEF1F6"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/tokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="User Token"
        android:textColorHint="#7A8295"
        android:textColor="#EEF1F6"
        android:inputType="textPassword"
        android:background="#1A1D26"
        android:padding="14dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/appIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Application ID"
        android:textColorHint="#7A8295"
        android:textColor="#EEF1F6"
        android:inputType="text"
        android:background="#1A1D26"
        android:padding="14dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/notifBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bật quyền thông báo"
        android:backgroundTint="#5865F2"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/usageBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bật quyền Usage Access"
        android:backgroundTint="#5865F2"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kết nối"
        android:backgroundTint="#4CE49A"
        android:textColor="#08090D"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/disconnectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ngắt kết nối"
        android:backgroundTint="#F26B6B"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa kết nối"
        android:textColor="#7A8295"
        android:textSize="13sp"
        android:gravity="center"/>
</LinearLayout>